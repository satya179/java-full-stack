import java.util.Scanner;
class Evennumoddnum{
static void enoOno(int a[],int n)
{
int even=0;
int odd=0;
for(int i=0;i<n;i++)
{
if(a[i]%2==0){
 even++;
}
else
{
    odd++;
}
}
System.out.println(even+" number of even numbers are present in array");
System.out.println(odd+" number of odd numbers are present in array");
}
public static void main(String args[])
{
Scanner sc=new Scanner(System.in);
System.out.println("enter the size of array:");
int n=sc.nextInt();
int a[]=new int[n];
System.out.println("enter the elements of array:");
for(int i=0;i<n;i++)
{
a[i]=sc.nextInt();
}
enoOno(a,n);
}
}
