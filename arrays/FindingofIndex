import java.util.Scanner;
class FindingofIndex{
static int find(int a[],int n,int el)
{

for(int i=0;i<n;i++)
{

if(el==a[i]){
  return i;

}
}
return -1;
}
public static void main(String args[])
{
Scanner sc=new Scanner(System.in);
System.out.println("enter the size of array:");
int n=sc.nextInt();
int a[]=new int[n];
System.out.println("enter the elements of array:");
for(int i=0;i<n;i++)
{
a[i]=sc.nextInt();
}
System.out.println("enter a element to the index:");
int el=sc.nextInt();
int index=find(a,n,el);
if(index!=-1){
System.out.print("the element "+el+" is  is found at"+index);
}
else{
System.out.print("the element "+el+" is not found in array");
}
}
}

